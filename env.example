# Environment variables for Docker deployment
# Copy this file to .env and update with your values

# CORS origin must match the public site origin (scheme + host).
# Production Timeweb example:
# CORS_ORIGIN=https://todolist.su
CORS_ORIGIN=http://localhost:3001

# Timeweb compose uses docker-compose.timeweb.yml and .env.timeweb
# App is published only as 127.0.0.1:3004 (see docker-compose.timeweb.yml).

# Database path inside container
DB_PATH=/app/data/database.sqlite

# Node environment
NODE_ENV=production

# Container listen port (mapped to host 127.0.0.1:3004)
PORT=3000

# Optional cookie override: true|false (default: Secure only when X-Forwarded-Proto=https)
# COOKIE_SECURE=false

